# Public URLs and Supabase values (required at build time and runtime)
NEXT_PUBLIC_APP_URL=https://kobara.app
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.kobara.app
NEXT_PUBLIC_KOBARA_API_URL=https://api.kobara.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=support@kobara.app
NEXT_PUBLIC_SUPPORT_PHONE=

# Core application secrets (required at runtime)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXTAUTH_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
KYC_IDENTITY_FINGERPRINT_SECRET=
CRON_SECRET=
TURNSTILE_SECRET_KEY=

# Redis rate limiting (required for production API rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local payment providers (required when the provider is enabled)
PAYM_API_URL=
PAYM_CLIENT_ID=
PAYM_CLIENT_SECRET=
BAZIK_API_URL=
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
BAZIK_WEBHOOK_SECRET=
SMS_GATEWAY_SECRET=

# PayPal and international payments (required when enabled)
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# KYC and compliance (required for production KYC)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
COMPLIANCE_AI_MODEL=gemini-2.5-pro
CGU_ANALYSIS_MODEL=
IPINFO_API_KEY=

# Transactional email and inbound support (required for email workflows)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
RESEND_SUPPORT_INBOUND_ADDRESS=
ADMIN_EMAIL=
COMPLIANCE_EMAIL=
SUPPORT_EMAIL=support@kobara.app
SUPPORT_COMPLIANCE_EMAIL=

# Optional SMTP fallback for compliance alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional alert channels
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Telegram is optional in production
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_COMMUNITY_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# Risk thresholds (optional; application defaults apply)
RISK_THRESHOLD_MEDIUM=
RISK_THRESHOLD_HIGH=
RISK_THRESHOLD_CRITICAL=
RISK_THRESHOLD_SUSPENDED=

# Migration scripts only; not required by the Worker runtime
DATABASE_URL=
SUPABASE_URL=
