# Public URLs and Supabase values (required at build time and runtime)
NEXT_PUBLIC_APP_URL=https://kobara.app
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.kobara.app
NEXT_PUBLIC_KOBARA_API_URL=https://api.kobara.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=support@kobara.app
NEXT_PUBLIC_SUPPORT_PHONE=

# Core application secrets (required at runtime)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXTAUTH_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
KYC_IDENTITY_FINGERPRINT_SECRET=
CRON_SECRET=
TURNSTILE_SECRET_KEY=

# Redis rate limiting (required for production API rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local payment providers (required when the provider is enabled)
PAYM_API_URL=
PAYM_CLIENT_ID=
PAYM_CLIENT_SECRET=
BAZIK_API_URL=
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
BAZIK_WEBHOOK_SECRET=
SMS_GATEWAY_SECRET=

# PayPal and international payments (required when enabled)
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# NOWPayments crypto payments and automated payouts
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_2FA_SECRET=

# KYC and compliance (required for production KYC)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
COMPLIANCE_AI_MODEL=gemini-2.5-pro
CGU_ANALYSIS_MODEL=
IPINFO_API_KEY=

# Resend: outbound backup only; also used by existing inbound support
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
RESEND_SUPPORT_INBOUND_ADDRESS=
# Amazon SES SMTP: primary transport for marketing (regional SMTP credentials)
SES_SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SES_SMTP_PORT=465
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_SMTP_FROM=Kobara <noreply@kobara.app>
ADMIN_EMAIL=
COMPLIANCE_EMAIL=
SUPPORT_EMAIL=support@kobara.app
SUPPORT_COMPLIANCE_EMAIL=

# Optional alert channels
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Telegram is optional in production
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_COMMUNITY_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp support is hosted in Kapso. Server-only; never NEXT_PUBLIC.
KAPSO_API_KEY=
KAPSO_PROJECT_ID=
# Provisioning script only; must identify a sandbox number.
KAPSO_SANDBOX_PHONE_NUMBER_ID=
# Optional immutable admin ID; defaults to the founder's authenticated admin email.
KAPSO_KNOWLEDGE_OWNER_ADMIN_ID=
SUPPORT_AI_ENABLED=true
ACTIVATION_REMINDERS_ENABLED=true
SMART_PROMOTIONS_ENABLED=true
PROMOTION_AI_MODEL=gemini-2.5-flash
PROMOTION_UNSUBSCRIBE_SECRET=
SUPPORT_AI_MODEL=gemini-2.5-flash
SUPPORT_AI_ALERT_EMAIL=support@kobara.app

# Risk thresholds (optional; application defaults apply)
RISK_THRESHOLD_MEDIUM=
RISK_THRESHOLD_HIGH=
RISK_THRESHOLD_CRITICAL=
RISK_THRESHOLD_SUSPENDED=

# Migration scripts only; not required by the Worker runtime
DATABASE_URL=
SUPABASE_URL=
# Server-only read access for System Core provider logs
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
CLOUDFLARE_OBSERVABILITY_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_LOG_QUERY_ID=

# Shopify Connect - server only
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://dashboard.kobara.app

# Transactional email: Workers EMAIL binding first, Resend fallback.
CLOUDFLARE_FROM_EMAIL=Kobara <noreply@kobara.app>
